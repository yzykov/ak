    "iblock_id": 5,
    "excluded_section_codes": [
      "zapchasty"
    ]
  },
  "sources": [
    {
      "name": "gkgross",
      "url": "https://gkgross.ru/",
      "mode": "sitemap_catalog",
      "product_prefix": "/catalog/",
      "allowed_image_hosts": [
        "gkgross.ru",
        "www.gkgross.ru"
      ],
      "excluded_paths": [
        "/catalog/zapchasty/",
        "/catalog/zapchasti/"
      ],
      "min_product_path_segments": 3
