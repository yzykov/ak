    {
      "name": "liftnet",
      "url": "https://www.liftnet.ru/katalog/dorozhno-stroitelnaja-tehnika/",
      "mode": "listing",
      "product_prefix": "/product/",
      "allowed_image_hosts": [
        "liftnet.ru",
        "www.liftnet.ru"
      ],
      "source_id_pattern": "-(?P<id>\\d{4,12})/?$"
    },
    {
      "name": "valmo",
      "url": "https://valmo-rus.ru/catalog/",
      "mode": "catalog_tree",
      "product_prefix": "/catalog/",
      "allowed_image_hosts": [
        "valmo-rus.ru",
        "www.valmo-rus.ru"
      ],
      "excluded_paths": [
        "/catalog/zapchasti/",
        "/catalog/zapchasty/"
      ],
      "min_product_path_segments": 4
    }
  ],
  "taxonomy": {
    "minimum_match_score": 90,
    "minimum_margin": 9,
    "section_aliases": {
        "valmo/catalog/shacman/sedelnye-tyagachi1/": "sedelnye-tyagachi",
        "valmo/catalog/liugong/": "dorozhno-stroitelnaya-tekhnika",
        "valmo/catalog/shacman/samosvaly-shacman1/": "samosvaly",
        "valmo/catalog/bus/": "kommercheskiy-transport",
        "valmo/catalog/shacman/avtobetonosmesitel./": "avtobetonosmesiteli",
        "valmo/catalog/shacman/shacman-f3000/samosval-": "samosvaly",
        "gkgross/catalog/avtobetonosmesiteli/": "avtobetonosmesiteli",
        "gkgross/catalog/kmu/": "dorozhno-stroitelnaya-tekhnika",
        "liftnet/product/lonking-": "dorozhno-stroitelnaya-tekhnika",
        "valmo/catalog/shacman/shacman-x3000/": "samosvaly",
        "valmo/catalog/shacman/shacman-x3000/tyagach-shacman-x3000-kmu/": "dorozhno-stroitelnaya-tekhnika",
