      }
  },
  "images": {
    "enabled": true,
    "max_images_per_product": 8,
    "max_bytes_each": 7340032,
    "gallery_property": "auto",
    "require_main_image_for_activation": true
  },
  "safety": {
    "max_deactivate": 5,
    "max_deactivate_percent": 5,
    "min_relative_to_baseline": 0.85,
    "require_baseline_for_deactivation": true,
    "allow_missing_catalog_categories": false,
    "require_clean_review_for_deactivation": true,
    "protected_section_codes": [
      "kommercheskiy-transport",
      "zapchasty"
    ]
  },
  "network": {
    "timeout_sec": 30,
    "delay_sec": 1.0,
    "max_pages": 1500,
    "max_listing_pages": 100,
    "checkpoint_every": 10,
    "bitrix_read_attempts": 3,
    "bitrix_retry_delay_sec": 1.5
  },
  "registry": {
    "type": "bitrix_json",
    "endpoint": "matching.php"
  }
}
